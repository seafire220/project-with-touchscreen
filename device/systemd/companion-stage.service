[Unit]
Description=Character device: the character on the screen
After=systemd-user-sessions.service companion-core.service
Conflicts=getty@tty1.service
# Never give up restarting: the screen must always come back.
StartLimitIntervalSec=0

[Service]
Type=simple
User=companion
Group=companion
PAMName=companion-stage
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# cage runs one full-screen program; the stage reads the current character
# from /var/lib/companion/current.inp, which the core points at the active
# character (its Live2D-format model or its Inochi2D puppet: the stage tells
# them apart by content) or at a setup card. When the core switches character it asks
# the stage to exit, and this service starts it again. current-map.json holds the
# owner's movement settings for that character (which of its parameters each
# control drives), written by the core; without it the stage chooses itself.
# current-stage.json holds a 3D avatar's animation style, its animation folders,
# how much its drawing may cost and how much of it to show.
ExecStart=/usr/bin/cage -s -d -- /opt/companion/bin/stage /var/lib/companion/current.inp --fullscreen --socket /run/companion/stage.sock --no-stdin --map /var/lib/companion/current-map.json --settings /var/lib/companion/current-stage.json
Restart=always
RestartSec=1
SupplementaryGroups=video render input
MemoryMax=300M

[Install]
WantedBy=graphical.target
