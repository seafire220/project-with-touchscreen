[Unit]
Description=Character device: conversation, settings page and Wi-Fi setup
After=network.target sound.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=companion
Group=companion
EnvironmentFile=-/etc/default/companion
ExecStart=/opt/companion/venv/bin/python -m companion --data /var/lib/companion --stage-socket /run/companion/stage.sock --port 80
WorkingDirectory=/opt/companion/core
Restart=always
RestartSec=2
# Port 80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/companion /run/companion
RuntimeDirectory=companion
RuntimeDirectoryPreserve=yes
SupplementaryGroups=audio input
MemoryMax=450M

[Install]
WantedBy=multi-user.target
