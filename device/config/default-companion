# Settings for the character device's core service (read by companion-core.service).
#
# The sound card is found automatically (a ReSpeaker first, then any USB sound
# card). To choose one yourself, run "aplay -l" and "arecord -l" and set, for
# example:
#COMPANION_ALSA_PLAYBACK=plughw:CARD=Lite
#COMPANION_ALSA_CAPTURE=plughw:CARD=Lite
#
# The USB connection to a computer: ncm (the usual; Windows 11, macOS and Linux have its driver built in),
# ecm (macOS and Linux), rndis (older Windows), or off.
#COMPANION_USB=ncm
